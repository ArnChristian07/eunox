{
  "expo": {
    "name": "eunox",
    "slug": "eunox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eunox",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8ADA57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.eunox"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#141413"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Eunox uses Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Eunox uses the camera to read receipts. Photos are processed on your phone and deleted after.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withBundledTextRecognition"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
